# Supabase Configuration (PUBLIC - Safe to expose)
# These are PUBLIC keys and should be in NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Note: NEVER add SUPABASE_SERVICE_ROLE_KEY here
# Service role keys are for server-side operations only and should NEVER be exposed to the frontend
